# Copy to .env for local development. Never commit .env.

# Port the HTTP server listens on.
PORT=3000

# development | test | production
NODE_ENV=development

# Sentry DSN for your own Sentry project (Settings -> Client Keys).
# Leave empty to run without Sentry: the app works, nothing is sent.
SENTRY_DSN=
# Fraction of requests traced, 0 to 1. 1 (trace everything) suits development, a demo and collecting evidence.
# For real traffic lower it (e.g. 0.1): every request creates a trace. The chosen rate is printed at startup.
# Leave empty for the default: 1 in development, 0.1 in production.
SENTRY_TRACES_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# Gemma (Checkpoint 2)
# ---------------------------------------------------------------------------
# none   = no model. Every walk is the deterministic fallback, honestly labelled "fallback".
# google = Gemma hosted on the Google Gemini API. Requires GEMINI_API_KEY.
# ollama = Gemma running locally via Ollama. Requires GEMMA_MODEL (your local model tag).
GEMMA_PROVIDER=none

# Google AI Studio API key (only for GEMMA_PROVIDER=google). Keep it secret.
GEMINI_API_KEY=

# Model id. For google it defaults to gemma-4-26b-a4b-it. For ollama it is required (no default).
GEMMA_MODEL=

# Ollama server (only for GEMMA_PROVIDER=ollama).
OLLAMA_BASE_URL=http://localhost:11434

# Latency budget for the model call in ms (500-120000). Past it the call is aborted and the
# deterministic fallback is served. 15000 is an unmeasured starting value; Checkpoint 7 measures it.
GEMMA_TIMEOUT_MS=15000
GEMMA_MAX_OUTPUT_TOKENS=1024
GEMMA_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Weather context (Checkpoint 3). All optional. No API key is needed or used.
# ---------------------------------------------------------------------------
# open-meteo = look up current weather + sunrise/sunset for the city a client sends (default).
# none       = never call a weather service. Requests with a location report weather as unavailable.
# Open-Meteo's free tier is for NON-COMMERCIAL use only. Review its terms before any commercial deployment.
# The city is sent to Open-Meteo's geocoder; rounded coordinates (about 1 km) go to its forecast service.
# Neither is logged, traced, or sent to Gemma.
WEATHER_PROVIDER=open-meteo

# Budget for the whole weather lookup (geocode + forecast) in ms (200-15000). Past it the lookup is
# aborted and the walk is planned without weather. 3000 is an unmeasured starting value; Checkpoint 7 measures it.
WEATHER_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Frontend (Checkpoint 5)
# ---------------------------------------------------------------------------
# The React app lives in frontend/ and has its OWN env file: see frontend/.env.example.
# This backend sends no CORS headers, so the frontend dev/preview server proxies /walks and /health
# to this server (frontend/.env.example: API_PROXY_TARGET, default http://localhost:3000).
# Nothing in this file is ever read by, or exposed to, the browser.

# ---------------------------------------------------------------------------
# Deployment (Checkpoint 9). Only NODE_ENV=production and TRUST_PROXY are mandatory, and only in production.
# ---------------------------------------------------------------------------
# REQUIRED in production. How many reverse proxies sit in front of this process (0 = clients connect directly).
# Too low: every user shares the proxy's address and one rate-limit bucket. Too high: clients can fake their address.
# Render, Fly.io, Railway, Cloud Run and similar hosts put exactly one proxy in front: use 1. Behind two (CDN + host): 2.
TRUST_PROXY=

# Interface to bind. Empty: all interfaces in production, Node's default otherwise.
HOST=
# Serve the built frontend (frontend/dist) from this process. Empty: true in production, false in development.
SERVE_FRONTEND=
FRONTEND_DIST_DIR=

# Whole-request server deadline in ms (5000-28000). Must stay under the browser's wait (VITE_REQUEST_TIMEOUT_MS, 30000).
REQUEST_DEADLINE_MS=25000
# POST /walks/plan per client address per window. RATE_LIMIT_MAX=0 disables the limiter (not recommended in production).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
# Simultaneous walk plans in this process. Extra requests get 503 immediately (no queue).
MAX_CONCURRENT_PLANS=8
# On SIGTERM/SIGINT, how long in-flight requests may finish before connections are closed.
SHUTDOWN_GRACE_MS=8000
