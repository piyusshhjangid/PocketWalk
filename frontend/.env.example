# PocketWalk frontend. Copy to .env.local if you need to change anything. Never commit .env files.
#
# WARNING: every VITE_* variable is bundled into the public JavaScript. Never put a secret here.

# Base URL of the PocketWalk API. Leave EMPTY (default) to call the same origin: in production the
# backend serves this app itself, and in development and `vite preview` the dev server proxies /walks
# and /health to the backend (see API_PROXY_TARGET). Only set a full URL (https://api.example.com) if
# you host the API separately: the backend sends no CORS headers, so that needs a reverse proxy in
# front of both, or a CORS change in the backend (not done).
VITE_API_BASE_URL=

# How long the browser waits for one walk before giving up, in ms. Backend budgets: Gemma 15 s +
# weather 3 s by default, so 30 s covers a slow-but-successful run.
VITE_REQUEST_TIMEOUT_MS=30000

# Node-side only (NOT exposed to the browser): where the dev/preview server forwards API calls.
API_PROXY_TARGET=http://localhost:3000
